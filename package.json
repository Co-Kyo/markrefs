{
    "name": "markrefs",
    "version": "0.1.0",
    "description": "Markdown cross-reference resolution and validation (name to path, existence, duplicates)",
    "keywords": [
        "markdown",
        "cross-reference",
        "references",
        "dependencies",
        "validation",
        "lint"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "markrefs": "bin/markrefs.mjs"
    },
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "files": [
        "dist",
        "bin"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Co-Kyo/markrefs.git"
    },
    "bugs": {
        "url": "https://github.com/Co-Kyo/markrefs/issues"
    },
    "homepage": "https://github.com/Co-Kyo/markrefs#readme",
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "pretest": "npm run build",
        "test": "node --test test/p0.test.mjs test/docgroup.test.mjs",
        "lint": "eslint .",
        "format": "eslint . --fix"
    },
    "devDependencies": {
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^26.1.0",
        "eslint": "^9.39.5",
        "eslint-plugin-jsonc": "^3.4.2",
        "typescript": "^5.5.0",
        "typescript-eslint": "^8.70.0"
    }
}
